{
  "rewrites": [
    { "source": "/drive-pdf", "destination": "/api/drive-pdf" },
    { "source": "/drive-extract", "destination": "/api/drive-extract" },
    { "source": "/((?!api/|drive-pdf|drive-extract).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
