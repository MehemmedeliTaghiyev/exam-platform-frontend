{
  "rewrites": [
    { "source": "/drive-pdf", "destination": "/api/drive-pdf" },
    { "source": "/drive-extract", "destination": "/api/drive-extract" },
    { "source": "/((?!api/|drive-pdf|drive-extract).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/drive-extract.js": {
      "maxDuration": 60,
      "includeFiles": "{node_modules/pdfjs-dist/**,node_modules/@napi-rs/**,node_modules/tesseract.js/**}"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
