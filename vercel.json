{
  "rewrites": [
    { "source": "/drive-pdf", "destination": "/api/drive-pdf" },
    { "source": "/drive-extract", "destination": "/api/drive-extract" },
    { "source": "/drive-folder", "destination": "/api/drive-folder" },
    { "source": "/pipeline/:path*", "destination": "/api/pipeline?path=:path*" },
    { "source": "/pipeline", "destination": "/api/pipeline" },
    { "source": "/urgent", "destination": "/api/urgent" },
    { "source": "/monthly-quiz", "destination": "/api/monthly-quiz" },
    { "source": "/((?!api/|pipeline|drive-pdf|drive-extract|drive-folder|urgent|monthly-quiz|\\.well-known/).*)", "destination": "/index.html" } }
  ],
  "functions": {
    "api/drive-extract.js": {
      "maxDuration": 60,
      "includeFiles": "node_modules/pdfjs-dist/legacy/build/**"
    },
    "api/pipeline.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ]
}
